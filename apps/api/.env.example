# Application
NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/ayllu_gen?schema=public"
JWT_SECRET="your-super-secret-jwt-key-must-be-at-least-32-characters-long"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=20m
# Retention: 14d = days; 14 = number of files (per transport).
LOG_FILE_MAX_FILES=14d
